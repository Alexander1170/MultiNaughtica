* text=auto

# Unity files
*.meta -merge=unityamlmerge -text
*.unity -merge=unityamlmerge -text
*.asset -merge=unityamlmerge -text
*.prefab -merge=unityamlmerge -text

# the installer batch files must have CRLF line endings (cmd.exe mishandles labels in LF-only files)
*.cmd text eol=crlf

# player models ship as binary files
*.glb binary

# Windows batch files need CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf
